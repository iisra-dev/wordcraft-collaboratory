# Copy to deploy/.env (gitignored) and edit.

# Public name Caddy serves and gets a certificate for.
WORDCRAFT_DOMAIN=wordcraft.example.com

# OIDC (Authentik). Set both or neither. With them set, access tokens from that provider sign in
# (users are created on first sign-in); local tokens from `create-user` keep working either way.
# OIDC_ISSUER must equal the tokens' `iss` exactly; Authentik's looks like
# https://auth.example.com/application/o/<slug>/ (trailing slash included). OIDC_AUDIENCE is the
# provider's client id for WordCraft.
OIDC_ISSUER=
OIDC_AUDIENCE=

RUST_LOG=info

# Encrypted backups (C6.2). One or more age public keys (age1…), separated by commas: make a key
# pair with `age-keygen -o key.txt`, put the "Public key" line here and keep key.txt OFF this
# machine (a password manager, a USB stick). Without it the backups cannot be read.
BACKUP_RECIPIENTS=
# How often (24h, 12h, 90m…) and how many to keep.
BACKUP_EVERY=24h
BACKUP_KEEP=14

# Optional: use compose.cloudflare.yaml INSTEAD OF compose.yaml for Cloudflare Tunnel (no Caddy).
# Route its hostname to http://wordcraft-collab:3000 in the Cloudflare dashboard. Access login
# pages block desktop clients: use Bypass on /api/* and /s/*, or configure WARP client access.
# Keep this token private. Pin CLOUDFLARED_IMAGE to a reviewed tag/digest for a deployed server.
TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
