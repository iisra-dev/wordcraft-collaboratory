# Copy to deploy/.env (gitignored) and edit.

# Public name Caddy serves and gets a certificate for.
WORDCRAFT_DOMAIN=wordcraft.example.com

# OIDC (Authentik). Set both or neither; sign-in is enforced from milestone C5.1.
# Authentik's issuer looks like https://auth.example.com/application/o/<slug>/
OIDC_ISSUER=
OIDC_AUDIENCE=

RUST_LOG=info
